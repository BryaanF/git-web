{
  "name": "gitdock-web",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first web GitHub Desktop companion for inspecting unstaged, staged, and verified pushed diffs without colliding with ports 80/443",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:pick": "node scripts/dev.ts --interactive",
    "dev:server": "node --watch src/server/index.ts",
    "dev:client": "vite",
    "runner": "node scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node src/server/index.ts",
    "start:pick": "node src/server/index.ts --interactive",
    "start:ts": "node src/server/index.ts --host 127.0.0.1 --port 8001 --strict-port --tailscale-port 8443 --ensure-build",
    "start:tailscale": "node src/server/index.ts --host 127.0.0.1 --port 8001 --strict-port --tailscale-port 8443 --ensure-build",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@git-diff-view/file": "^0.1.8",
    "@git-diff-view/react": "^0.1.8",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.22",
    "lucide-react": "^1.81.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "^8.3.8"
  }
}
